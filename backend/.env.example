# Copia este archivo como ".env" y ajusta los valores
DATABASE_URL=postgres://postgres:loljkm123@localhost:5432/jacha
PORT=3001

# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=jacha_tours_secret_key_cambiar_en_produccion_2026

# Duración de la sesión: admin y clientes
JWT_EXPIRES=12h
CLIENT_JWT_EXPIRES=30d

# Admin inicial (solo se usa si el usuario todavía no existe).
# Si dejas ADMIN_PASSWORD vacío, se genera una al azar y se muestra al arrancar.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Opcionales ---
# NODE_ENV=production
# DB_SSL=true                      # bases en la nube (Neon, Supabase, Render)
# TRUST_PROXY=true                 # si está detrás de nginx / Render / Railway
# CORS_ORIGIN=https://tudominio.com
